# --- Environment for the backend (copy to .env and edit) ---

# SQLite file. Swap for postgresql+psycopg://... later without code changes.
DATABASE_URL=sqlite:///./signal_clone.db

# CHANGE THIS before deploying - anyone with the secret can mint tokens.
JWT_SECRET=dev-secret-change-me-in-production
JWT_EXPIRE_HOURS=720

# Mocked verification code accepted by /auth/verify-otp
MOCK_OTP=123456

# Comma separated list of allowed frontend origins (CORS)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Uploads on disk + their size cap
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Seed demo data on first boot / run the disappearing-message sweeper
SEED_ON_BOOT=true
SWEEPER_INTERVAL_SECONDS=5
